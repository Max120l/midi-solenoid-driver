# The organ's front desk, always on. Install with:
#
#   sudo cp organ-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now organ-web
#
# Adjust User, the repo path and the options below to the Pi. The Python it
# names must have flask, mido, pyserial, pyyaml and (for --pump / reset)
# gpiozero lgpio; here that is the system python3.
# The user needs the dialout group for /dev/serial0 and gpio for the pins.

[Unit]
Description=Band organ front desk (organ_web + grinder)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=massie
WorkingDirectory=/home/massie/organ/tools/organ-web
ExecStart=/usr/bin/python3 organ_web.py \
    --library /home/massie/tunes \
    --organ /home/massie/organ/tools/organ-arranger/instrument/organ.yaml \
    --state /home/massie/.local/share/organ-web \
    --device /dev/serial0 \
    --port 8080 \
    --pump 24 \
    --power-switch 3
# --pump 24: the SSR for the bellows motor.  --power-switch 3: the antique
# on-off switch, GPIO 3 to ground (open = shut down; closed wakes a halted Pi).
# --power GPIO would switch the 12 V supply through an opto on ATX PS_ON;
# Pellevoisin ties PS_ON to ground instead, so the 12 V is on whenever the
# panel is in Auto and the flag is left out. The app says which relays it has.
# The player's status file, rewritten every second, goes to /dev/shm (RAM)
# by itself; the state folder is written only when a setting or a playlist
# changes. See "Power cuts" in the README for the rest of the card's safety.
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
